<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biondini</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Microplataforma.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="public-header">
        <div class="public-shell header-content">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Biondini, página inicial">Biondini</a>
            <nav aria-label="Navegação principal">
                <a href="@Url.Action("Index", "Home")#representantes">Representantes</a>
            </nav>
        </div>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-shell">
            <span>Biondini</span>
            <p>Informações oficiais em um único lugar.</p>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
