@model Microplataforma.Domain.Entities.Candidate

@{
    ViewData["Title"] = $"{Model.Name} | {Model.Office}";
    var initial = string.IsNullOrWhiteSpace(Model.Name) ? "B" : Model.Name[..1].ToUpperInvariant();
    var hasHeroImage = !string.IsNullOrWhiteSpace(Model.HeroImageUrl);
    var profileImage = !string.IsNullOrWhiteSpace(Model.PhotoUrl) ? Model.PhotoUrl : Model.HeroImageUrl;
    var hasBiography = !string.IsNullOrWhiteSpace(Model.Biography);
    var hasShortBiography = !string.IsNullOrWhiteSpace(Model.ShortBiography);
    var proposals = Model.Contents
        .Where(content => content.Type == Microplataforma.Domain.Enums.ContentType.Proposal)
        .ToList();
    var videos = Model.Contents
        .Where(content =>
            content.Type == Microplataforma.Domain.Enums.ContentType.Video
            && Uri.TryCreate(content.VideoUrl?.Trim(), UriKind.Absolute, out var videoUri)
            && (videoUri.Scheme == Uri.UriSchemeHttps || videoUri.Scheme == Uri.UriSchemeHttp))
        .ToList();
    var agendaEvents = Model.Events.ToList();
    var materials = Model.Materials.ToList();
    var socialLinks = Model.SocialLinks
        .Where(socialLink =>
            Uri.TryCreate(socialLink.Url?.Trim(), UriKind.Absolute, out var socialUri)
            && (socialUri.Scheme == Uri.UriSchemeHttps || socialUri.Scheme == Uri.UriSchemeHttp))
        .ToList();
    var ptBrCulture = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var profileTimeZone = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var biographyParagraphs = hasBiography
        ? Model.Biography
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        : [];
}

<article class="candidate-profile">
    <section class="candidate-hero@(hasHeroImage ? " candidate-hero--with-image" : string.Empty)"
             aria-labelledby="candidate-name"
             @if (hasHeroImage)
             {
                 <text>style="--candidate-hero-image: url('@Model.HeroImageUrl')"</text>
             }>
        <div class="public-shell candidate-hero-grid">
            <div class="candidate-hero-copy">
                <a class="back-home-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> Voltar para a Home</a>
                <p class="eyebrow">Perfil oficial</p>
                <p class="candidate-office">@Model.Office</p>
                <h1 id="candidate-name">@Model.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.ShortBiography))
                {
                    <p class="candidate-intro">@Model.ShortBiography</p>
                }
                <div class="candidate-actions" aria-label="Atalhos do perfil">
                    <a class="btn btn-gold" href="#trajetoria">Conheça a trajetória</a>
                    <a class="btn candidate-secondary-action" href="#propostas">Propostas e compromissos</a>
                </div>
            </div>
            <div class="candidate-portrait" aria-label="Foto de @Model.Name">
                @if (!string.IsNullOrWhiteSpace(profileImage))
                {
                    <img src="@profileImage" alt="@Model.Name" />
                }
                else
                {
                    <span aria-hidden="true">@initial</span>
                    <small>Foto oficial</small>
                }
            </div>
        </div>
    </section>

    <section id="trajetoria" class="public-section candidate-story-section" aria-labelledby="trajectory-title">
        <div class="public-shell candidate-story-grid">
            <header class="section-heading candidate-story-heading">
                <p class="eyebrow">Trajetória</p>
                <h2 id="trajectory-title">Trajetória de @Model.Name</h2>
                <div class="candidate-story-identity">
                    <span aria-hidden="true">@initial</span>
                    <p><strong>@Model.Name</strong><small>@Model.Office</small></p>
                </div>
            </header>
            <div class="candidate-biography" aria-label="Biografia de @Model.Name">
                @if (hasShortBiography && (!hasBiography || !string.Equals(Model.ShortBiography.Trim(), Model.Biography.Trim(), StringComparison.Ordinal)))
                {
                    <p class="candidate-biography-lead">@Model.ShortBiography</p>
                }

                @if (hasBiography)
                {
                    <div class="candidate-biography-copy">
                        @foreach (var paragraph in biographyParagraphs)
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                }
                else
                {
                    <div class="candidate-biography-empty">
                        <span class="candidate-biography-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 4.75h9.5A2.5 2.5 0 0 1 18 7.25v12H8.5A2.5 2.5 0 0 0 6 21.75v-17Z" /><path d="M6 4.75v17" /><path d="M9.5 9h5M9.5 12.5h5" /></svg>
                        </span>
                        <div>
                            <h3>Biografia ainda não publicada</h3>
                            <p>A trajetória completa ainda não está disponível neste perfil.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section id="propostas" class="public-section candidate-proposals-section" aria-labelledby="proposals-title">
        <div class="public-shell">
            <header class="section-heading candidate-proposals-heading">
                <div>
                    <p class="eyebrow">Atuação</p>
                    <h2 id="proposals-title">Propostas e compromissos</h2>
                </div>
                <p>Conteúdos publicados no perfil de @Model.Name.</p>
            </header>

            @if (proposals.Count > 0)
            {
                <div class="candidate-proposals-grid" aria-label="Propostas e compromissos de @Model.Name">
                    @foreach (var proposal in proposals)
                    {
                        <article class="candidate-proposal-card">
                            <span class="candidate-proposal-label">Proposta</span>
                            <h3>@proposal.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(proposal.Summary))
                            {
                                <p>@proposal.Summary</p>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="candidate-proposals-empty">
                    <span class="candidate-proposals-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M5 12.5 9 16l10-10" /><path d="M19 12a7.5 7.5 0 1 1-4.4-6.84" /></svg>
                    </span>
                    <div>
                        <h3>Nenhuma proposta publicada</h3>
                        <p>Não há propostas ou compromissos disponíveis neste perfil no momento.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="videos" class="public-section candidate-videos-section" aria-labelledby="videos-title">
        <div class="public-shell">
            <header class="section-heading candidate-videos-heading">
                <div>
                    <p class="eyebrow">Assista</p>
                    <h2 id="videos-title">Vídeos</h2>
                </div>
                <p>Conteúdos em vídeo publicados no perfil de @Model.Name.</p>
            </header>

            @if (videos.Count > 0)
            {
                <div class="candidate-videos-grid" aria-label="Vídeos de @Model.Name">
                    @foreach (var video in videos)
                    {
                        var videoUrl = video.VideoUrl!.Trim();
                        var thumbnailUrl = video.ImageUrl?.Trim();
                        var thumbnailIsAbsolute = Uri.TryCreate(thumbnailUrl, UriKind.Absolute, out var absoluteThumbnailUri);
                        var thumbnailIsExternal = thumbnailIsAbsolute
                            && (absoluteThumbnailUri!.Scheme == Uri.UriSchemeHttps || absoluteThumbnailUri.Scheme == Uri.UriSchemeHttp);
                        var thumbnailIsLocal = !thumbnailIsAbsolute
                            && !string.IsNullOrWhiteSpace(thumbnailUrl)
                            && thumbnailUrl.StartsWith('/')
                            && !thumbnailUrl.StartsWith("//");
                        var hasSafeThumbnail = thumbnailIsExternal || thumbnailIsLocal;

                        <article class="candidate-video-card">
                            <div class="candidate-video-thumbnail">
                                @if (hasSafeThumbnail)
                                {
                                    <img src="@thumbnailUrl" alt="" loading="lazy" decoding="async" />
                                }
                                <span class="candidate-video-play" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z" /></svg>
                                </span>
                            </div>
                            <div class="candidate-video-body">
                                <h3>@video.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(video.Summary))
                                {
                                    <p>@video.Summary</p>
                                }
                                <a class="candidate-video-link"
                                   href="@videoUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="Assistir @video.Title (abre em nova aba)">
                                    Assistir
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h10v10M19 5 8 16" /><path d="M15 19H5V9" /></svg>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="candidate-videos-empty">
                    <span class="candidate-videos-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="4" /><path d="m10 9 5 3-5 3V9Z" /></svg>
                    </span>
                    <div>
                        <h3>Nenhum vídeo disponível</h3>
                        <p>Não há vídeos publicados com endereço válido neste perfil no momento.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="agenda" class="public-section candidate-agenda-section" aria-labelledby="agenda-title">
        <div class="public-shell">
            <header class="section-heading candidate-agenda-heading">
                <div>
                    <p class="eyebrow">Próximos eventos</p>
                    <h2 id="agenda-title">Agenda</h2>
                </div>
                <p>Compromissos futuros publicados no perfil de @Model.Name.</p>
            </header>

            @if (agendaEvents.Count > 0)
            {
                <div class="candidate-agenda-grid" aria-label="Próximos eventos de @Model.Name">
                    @foreach (var agendaEvent in agendaEvents)
                    {
                        var startsAt = TimeZoneInfo.ConvertTime(agendaEvent.StartsAt, profileTimeZone);
                        var endsAt = agendaEvent.EndsAt.HasValue
                            ? TimeZoneInfo.ConvertTime(agendaEvent.EndsAt.Value, profileTimeZone)
                            : (DateTimeOffset?)null;
                        var startIso = agendaEvent.StartsAt.ToString("O");
                        var endIso = agendaEvent.EndsAt?.ToString("O");
                        var accessibleStart = startsAt.ToString("f", ptBrCulture);
                        var endLabel = endsAt.HasValue
                            ? endsAt.Value.ToString(endsAt.Value.Date == startsAt.Date ? "HH:mm" : "dd/MM HH:mm", ptBrCulture)
                            : string.Empty;

                        <article class="candidate-event-card">
                            <header class="candidate-event-header">
                                <time class="candidate-event-date" datetime="@startIso" aria-label="@accessibleStart">
                                    <strong>@startsAt.ToString("dd", ptBrCulture)</strong>
                                    <span>@startsAt.ToString("MMM", ptBrCulture).TrimEnd('.').ToUpper(ptBrCulture)</span>
                                    <small>@startsAt.ToString("yyyy", ptBrCulture)</small>
                                </time>
                                <div>
                                    <p class="candidate-event-time">
                                        <time datetime="@startIso">@startsAt.ToString("HH:mm", ptBrCulture)</time>
                                        @if (endsAt.HasValue)
                                        {
                                            <span aria-hidden="true">—</span>
                                            <time datetime="@endIso">@endLabel</time>
                                        }
                                    </p>
                                    <h3>@agendaEvent.Title</h3>
                                </div>
                            </header>

                            @if (!string.IsNullOrWhiteSpace(agendaEvent.Location))
                            {
                                <p class="candidate-event-location">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></svg>
                                    <span>@agendaEvent.Location</span>
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(agendaEvent.Description))
                            {
                                <p class="candidate-event-description">@agendaEvent.Description</p>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="candidate-agenda-empty">
                    <span class="candidate-agenda-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /><path d="M8 14h.01M12 14h.01M16 14h.01" /></svg>
                    </span>
                    <div>
                        <h3>Nenhum evento futuro</h3>
                        <p>Não há compromissos publicados na agenda deste perfil no momento.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="materiais" class="public-section candidate-materials-section" aria-labelledby="materials-title">
        <div class="public-shell">
            <header class="section-heading candidate-materials-heading">
                <div>
                    <p class="eyebrow">Para consultar</p>
                    <h2 id="materials-title">Materiais</h2>
                </div>
                <p>Arquivos e documentos disponibilizados no perfil de @Model.Name.</p>
            </header>

            @if (materials.Count > 0)
            {
                <div class="candidate-materials-grid" aria-label="Materiais de @Model.Name">
                    @foreach (var material in materials)
                    {
                        var fileUrl = material.FileUrl?.Trim();
                        var fileIsAbsolute = Uri.TryCreate(fileUrl, UriKind.Absolute, out var absoluteFileUri);
                        var fileIsExternal = fileIsAbsolute
                            && (absoluteFileUri!.Scheme == Uri.UriSchemeHttps || absoluteFileUri.Scheme == Uri.UriSchemeHttp);
                        var fileIsLocal = !fileIsAbsolute
                            && !string.IsNullOrWhiteSpace(fileUrl)
                            && fileUrl.StartsWith('/')
                            && !fileUrl.StartsWith("//");
                        var hasSafeFileUrl = fileIsExternal || fileIsLocal;

                        var thumbnailUrl = material.ThumbnailUrl?.Trim();
                        var thumbnailIsAbsolute = Uri.TryCreate(thumbnailUrl, UriKind.Absolute, out var absoluteThumbnailUri);
                        var thumbnailIsExternal = thumbnailIsAbsolute
                            && (absoluteThumbnailUri!.Scheme == Uri.UriSchemeHttps || absoluteThumbnailUri.Scheme == Uri.UriSchemeHttp);
                        var thumbnailIsLocal = !thumbnailIsAbsolute
                            && !string.IsNullOrWhiteSpace(thumbnailUrl)
                            && thumbnailUrl.StartsWith('/')
                            && !thumbnailUrl.StartsWith("//");
                        var hasSafeThumbnail = thumbnailIsExternal || thumbnailIsLocal;

                        <article class="candidate-material-card">
                            <div class="candidate-material-thumbnail">
                                @if (hasSafeThumbnail)
                                {
                                    <img src="@thumbnailUrl" alt="" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M7 3.75h7l3 3v13.5H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z" /><path d="M14 3.75v4h3M8.5 12h7M8.5 15.5h7" /></svg>
                                    </span>
                                }
                            </div>
                            <div class="candidate-material-body">
                                <h3>@material.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(material.Description))
                                {
                                    <p>@material.Description</p>
                                }

                                @if (hasSafeFileUrl)
                                {
                                    <a class="candidate-material-link"
                                       href="@fileUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Acessar @material.Title (abre em nova aba)">
                                        Acessar arquivo
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h10v10M19 5 8 16" /><path d="M15 19H5V9" /></svg>
                                    </a>
                                }
                                else
                                {
                                    <span class="candidate-material-unavailable">Arquivo indisponível</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="candidate-materials-empty">
                    <span class="candidate-materials-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M7 3.75h7l3 3v13.5H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z" /><path d="M14 3.75v4h3M8.5 12h7M8.5 15.5h7" /></svg>
                    </span>
                    <div>
                        <h3>Nenhum material disponível</h3>
                        <p>Não há arquivos ou documentos publicados neste perfil no momento.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="redes" class="public-section candidate-social-section" aria-labelledby="social-title">
        <div class="public-shell">
            <header class="section-heading candidate-social-heading">
                <div>
                    <p class="eyebrow">Canais verificados</p>
                    <h2 id="social-title">Redes oficiais</h2>
                </div>
                <p>Acesse os canais oficiais de @Model.Name.</p>
            </header>

            @if (socialLinks.Count > 0)
            {
                <div class="candidate-social-grid" aria-label="Redes oficiais de @Model.Name">
                    @foreach (var socialLink in socialLinks)
                    {
                        var platform = string.IsNullOrWhiteSpace(socialLink.Platform) ? "Canal oficial" : socialLink.Platform.Trim();
                        var platformKey = platform.ToLowerInvariant();
                        var socialUrl = socialLink.Url.Trim();

                        <a class="candidate-social-card"
                           href="@socialUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Acessar @platform de @Model.Name (abre em nova aba)">
                            <span class="candidate-social-icon" aria-hidden="true">
                                @if (platformKey.Contains("instagram"))
                                {
                                    <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.6h.01" /></svg>
                                }
                                else if (platformKey.Contains("facebook"))
                                {
                                    <svg viewBox="0 0 24 24"><path d="M13.5 21v-8h3l.5-3h-3.5V8.3c0-1 .35-1.8 1.85-1.8H17V3.8c-.6-.1-1.65-.2-2.8-.2-2.8 0-4.7 1.7-4.7 4.8V10H7v3h2.5v8" /></svg>
                                }
                                else if (platformKey.Contains("youtube"))
                                {
                                    <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="4" /><path d="m10 9 5 3-5 3V9Z" /></svg>
                                }
                                else if (platformKey == "x" || platformKey.Contains("twitter"))
                                {
                                    <svg viewBox="0 0 24 24"><path d="m5 4 14 16M19 4 5 20" /></svg>
                                }
                                else if (platformKey.Contains("linkedin"))
                                {
                                    <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="2" /><path d="M8 10v7M8 7.2v.1M12 17v-7M12 13a3 3 0 0 1 6 0v4" /></svg>
                                }
                                else if (platformKey.Contains("tiktok"))
                                {
                                    <svg viewBox="0 0 24 24"><path d="M14 4v11.5a4 4 0 1 1-3.2-3.92M14 4c.55 2.5 2 4 4.5 4.5" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M4.75 12h14.5M12 4a12.5 12.5 0 0 1 0 16M12 4a12.5 12.5 0 0 0 0 16" /></svg>
                                }
                            </span>
                            <span class="candidate-social-copy">
                                <strong>@platform</strong>
                                <small>Acessar canal oficial</small>
                            </span>
                            <svg class="candidate-social-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h10v10M19 5 8 16" /><path d="M15 19H5V9" /></svg>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="candidate-social-empty">
                    <span class="candidate-social-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M4.75 12h14.5M12 4a12.5 12.5 0 0 1 0 16M12 4a12.5 12.5 0 0 0 0 16" /></svg>
                    </span>
                    <div>
                        <h3>Nenhuma rede oficial disponível</h3>
                        <p>Não há canais oficiais publicados neste perfil no momento.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="acompanhe" class="public-section candidate-access-section" aria-labelledby="candidate-access-title">
        <div class="public-shell">
            <div class="section-heading candidate-access-heading">
                <div><p class="eyebrow">Acompanhe</p><h2 id="candidate-access-title">Atuação em um só lugar</h2></div>
                <p>Os módulos oficiais serão disponibilizados aqui conforme forem publicados.</p>
            </div>
            <div class="candidate-access-grid" aria-label="Módulos do perfil">
                <a class="candidate-access-card candidate-access-card--link" href="#videos"><span class="quick-access-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2" /><path d="m10 9 5 3-5 3V9Z" /></svg></span><div><h3>Vídeos</h3><p>Conteúdos audiovisuais publicados no perfil.</p></div><small>Ver vídeos</small></a>
                <a class="candidate-access-card candidate-access-card--link" href="#agenda"><span class="quick-access-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /><path d="M8 14h.01M12 14h.01M16 14h.01" /></svg></span><div><h3>Agenda</h3><p>Compromissos e próximos encontros.</p></div><small>Ver agenda</small></a>
                <a class="candidate-access-card candidate-access-card--link" href="#materiais"><span class="quick-access-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.75h7l3 3v13.5H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z" /><path d="M14 3.75v4h3M8.5 12h7M8.5 15.5h7" /></svg></span><div><h3>Materiais</h3><p>Documentos e materiais para consulta.</p></div><small>Ver materiais</small></a>
                <a class="candidate-access-card candidate-access-card--link" href="#redes"><span class="quick-access-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M4.75 12h14.5M12 4a12.5 12.5 0 0 1 0 16M12 4a12.5 12.5 0 0 0 0 16" /></svg></span><div><h3>Redes oficiais</h3><p>Canais verificados de comunicação.</p></div><small>Ver redes</small></a>
            </div>
        </div>
    </section>

    <section class="candidate-home-cta" aria-labelledby="candidate-home-title">
        <div class="public-shell"><div class="candidate-home-panel">
            <div><p class="eyebrow">Plataforma Biondini</p><h2 id="candidate-home-title">Conheça também os demais representantes.</h2></div>
            <a class="btn btn-gold" asp-controller="Home" asp-action="Index" asp-fragment="representantes">Ir para a Home</a>
        </div></div>
    </section>
</article>
